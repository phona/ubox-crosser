# ═══════════════════════════════════════════════════
# Test image: builds all 3 binaries + Go test toolchain
# ═══════════════════════════════════════════════════

FROM golang:1.23

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build all binaries with coverage instrumentation
RUN CGO_ENABLED=0 go build -cover -o /app/client ./cmd/client && \
    CGO_ENABLED=0 go build -cover -o /app/server ./cmd/server && \
    CGO_ENABLED=0 go build -cover -o /app/auth_server ./cmd/auth_server

ENV PATH="/app:${PATH}"
